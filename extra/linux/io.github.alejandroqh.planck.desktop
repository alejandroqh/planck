[Desktop Entry]
Version=1.0
Type=Application

Name=Planck
Comment=Fast, focused code editor
Categories=Development;IDE;
GenericName=Code Editor
StartupWMClass=planck

Icon=io.github.alejandroqh.planck
Exec=planck %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=planck --new %F
Icon=io.github.alejandroqh.planck
